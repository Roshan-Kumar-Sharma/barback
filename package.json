{
  "name": "barback",
  "version": "0.1.0",
  "description": "Open-source risk intake and carrier appetite matching for restaurant & bar insurance. Name + state in, provenance-tracked underwriting profile out.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "barback": "./dist/cli/index.js"
  },
  "scripts": {
    "barback": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --exclude test/temporal.test.ts",
    "test:watch": "vitest",
    "lint:layers": "depcruise src --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint:layers && pnpm test"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@temporalio/activity": "^1.23.0",
    "@temporalio/client": "^1.23.0",
    "@temporalio/worker": "^1.23.0",
    "@temporalio/workflow": "^1.23.0",
    "commander": "^12.1.0",
    "p-limit": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@temporalio/testing": "^1.23.0",
    "@types/node": "^22.9.0",
    "dependency-cruiser": "^16.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
