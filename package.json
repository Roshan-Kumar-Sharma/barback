{
  "name": "barback",
  "version": "0.1.0",
  "description": "Open-source risk intake and carrier appetite matching for restaurant & bar insurance. Name + state in, provenance-tracked underwriting profile out.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "bin": { "barback": "./dist/cli/index.js" },
  "scripts": {
    "barback": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:layers": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "p-limit": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "dependency-cruiser": "^16.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
