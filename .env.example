# All Phase 1 government sources work with NO credentials.
# Everything below is optional and degrades to null + a question.

# Socrata app token — optional. Without it you share an anonymous rate-limit
# pool with everyone else. Free: https://data.texas.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# LLM used ONLY for extraction from a venue's own website (method: 'inferred').
# Any OpenAI-compatible endpoint. Defaults below cost nothing.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Identifies us to public data portals. Please set a real contact address.
BARBACK_USER_AGENT=
